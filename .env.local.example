# Local release credentials for port/tools/release.sh (gitignored).
# Copy to .env.local and fill in. CLI KEY=VALUE args override these.

CODE_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
DEVELOPMENT_TEAM=TEAMID
CODE_SIGN_STYLE=Manual

# Notarization: after a one-time `notarytool store-credentials` (see
# port/HOWTO-DISTRIBUTE.md), only the profile *name* is needed here. Do not put
# the Apple app-specific password in this file for day-to-day releases — it
# belongs in the keychain profile.
NOTARY_PROFILE=com.yourNotaryProfile

# Optional — only for the one-time store-credentials step (or omit and pass on CLI):
# APPLE_ID=you@example.com
# NOTARY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
