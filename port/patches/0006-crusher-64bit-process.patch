From 4a3a293436a092d0e3ab5b7a3074667342ce9a26 Mon Sep 17 00:00:00 2001
From: Matt Hardy <matt@deuso.de>
Date: Sun, 27 Sep 2026 21:14:15 +0200
Subject: [PATCH] crusher: run bit reduction when the host processes in
 64-bit.

The quantizer only read channelBuffers32 and returned on a 64-bit
block, so the signal passed through with gain only. The response
curve is drawn from the knobs, so the UI still looked active.
---
 dsp/crusher/source/crusher_dsp.cpp | 126 ++++++++++++++++++++---------
 dsp/crusher/source/crusher_dsp.h   |   6 ++
 2 files changed, 92 insertions(+), 40 deletions(-)

diff --git a/dsp/crusher/source/crusher_dsp.cpp b/dsp/crusher/source/crusher_dsp.cpp
index 30a8877..2faec57 100644
--- a/dsp/crusher/source/crusher_dsp.cpp
+++ b/dsp/crusher/source/crusher_dsp.cpp
@@ -60,6 +60,12 @@ tresult PLUGIN_API CrusherPlugin::setupProcessing(ProcessSetup& newSetup)
 {
   sampleRate_ = newSetup.sampleRate > 0.0 ? newSetup.sampleRate : 44100.0;
   bit_.setSampleRate(static_cast<uint32_t>(sampleRate_));
+  const int cap = std::max(64, static_cast<int>(newSetup.maxSamplesPerBlock));
+  if (cap != blockCap_)
+  {
+    blockScratch_.assign(static_cast<size_t>(cap) * 2, 0.f);
+    blockCap_ = cap;
+  }
   resetProcessing();
   return EffectBase::setupProcessing(newSetup);
 }
@@ -101,45 +107,12 @@ void CrusherPlugin::observeSend(float sendL, float sendR)
   histAcc_[bin] += 1.f;
 }
 
-tresult PLUGIN_API CrusherPlugin::process(ProcessData& data)
+void CrusherPlugin::crushBlock(float* left, float* right, int nFrames, const BlockState& state)
 {
-  syncParamPlains(data, params_, kParamCount);
-
-  const BlockState state = makeBlockState();
-  applyCrushParams(state);
-  io_.setBypassGains(state.bypass);
-  io_.setGainsDb(params_[kParamInGain], params_[kParamOutGain]);
-
-  const bool hasHostAudio = io_.begin(data);
-  if (!hasHostAudio)
-    return kResultOk;
-
-  const int32 nFrames = data.numSamples;
-  if (nFrames <= 0)
-  {
-    io_.end(data);
-    return kResultOk;
-  }
-
-  if (state.bypass || io_.inputWasQuiet())
-  {
-    shapeZone_ *= std::pow(shapeZoneFall_, static_cast<float>(nFrames));
-    io_.end(data);
-    return kResultOk;
-  }
-
-  auto** outs = data.outputs[0].channelBuffers32;
-  if (!outs || data.symbolicSampleSize != kSample32)
-  {
-    io_.end(data);
-    return kResultOk;
-  }
-
-  const int32 nCh = data.outputs[0].numChannels;
-  for (int32 i = 0; i < nFrames; ++i)
+  for (int i = 0; i < nFrames; ++i)
   {
-    const float inL = outs[0][i];
-    const float inR = (nCh > 1 && outs[1]) ? outs[1][i] : inL;
+    const float inL = left[i];
+    const float inR = right ? right[i] : inL;
     float L = inL;
     float R = inR;
 
@@ -185,9 +158,82 @@ tresult PLUGIN_API CrusherPlugin::process(ProcessData& data)
 
     Dsp::sanitizeDenormal(L);
     Dsp::sanitizeDenormal(R);
-    outs[0][i] = L;
-    if (nCh > 1 && outs[1])
-      outs[1][i] = R;
+    left[i] = L;
+    if (right)
+      right[i] = R;
+  }
+}
+
+tresult PLUGIN_API CrusherPlugin::process(ProcessData& data)
+{
+  syncParamPlains(data, params_, kParamCount);
+
+  const BlockState state = makeBlockState();
+  applyCrushParams(state);
+  io_.setBypassGains(state.bypass);
+  io_.setGainsDb(params_[kParamInGain], params_[kParamOutGain]);
+
+  const bool hasHostAudio = io_.begin(data);
+  if (!hasHostAudio)
+    return kResultOk;
+
+  const int32 nFrames = data.numSamples;
+  if (nFrames <= 0)
+  {
+    io_.end(data);
+    return kResultOk;
+  }
+
+  if (state.bypass || io_.inputWasQuiet())
+  {
+    shapeZone_ *= std::pow(shapeZoneFall_, static_cast<float>(nFrames));
+    io_.end(data);
+    return kResultOk;
+  }
+
+  const int32 nCh = data.outputs[0].numChannels;
+  const bool is64 = data.symbolicSampleSize != kSample32;
+  if (!is64)
+  {
+    auto** outs32 = data.outputs[0].channelBuffers32;
+    if (!outs32 || !outs32[0])
+    {
+      io_.end(data);
+      return kResultOk;
+    }
+    float* right = (nCh > 1 && outs32[1]) ? outs32[1] : nullptr;
+    crushBlock(outs32[0], right, nFrames, state);
+  }
+  else
+  {
+    double** outs64 = data.outputs[0].channelBuffers64;
+    if (!outs64 || !outs64[0] || blockCap_ < 1)
+    {
+      io_.end(data);
+      return kResultOk;
+    }
+    float* left = blockScratch_.data();
+    float* right = (nCh > 1 && outs64[1]) ? left + blockCap_ : nullptr;
+    for (int32 done = 0; done < nFrames;)
+    {
+      const int32 n = std::min(blockCap_, nFrames - done);
+      for (int32 i = 0; i < n; ++i)
+        left[i] = static_cast<float>(outs64[0][done + i]);
+      if (right)
+      {
+        for (int32 i = 0; i < n; ++i)
+          right[i] = static_cast<float>(outs64[1][done + i]);
+      }
+      crushBlock(left, right, n, state);
+      for (int32 i = 0; i < n; ++i)
+        outs64[0][done + i] = left[i];
+      if (right)
+      {
+        for (int32 i = 0; i < n; ++i)
+          outs64[1][done + i] = right[i];
+      }
+      done += n;
+    }
   }
 
   io_.end(data);
diff --git a/dsp/crusher/source/crusher_dsp.h b/dsp/crusher/source/crusher_dsp.h
index 0c60f56..4f364d2 100644
--- a/dsp/crusher/source/crusher_dsp.h
+++ b/dsp/crusher/source/crusher_dsp.h
@@ -8,6 +8,8 @@
 
 #include "crusher_params.h"
 
+#include <vector>
+
 namespace calfNXT {
 namespace Crusher {
 
@@ -61,6 +63,7 @@ private:
   void resetProcessing();
   void applyCrushParams(const BlockState& s);
   void observeSend(float sendL, float sendR);
+  void crushBlock(float* left, float* right, int nFrames, const BlockState& state);
 
   float params_[kParamCount] {};
   Dsp::IoStage io_;
@@ -71,6 +74,9 @@ private:
   float shapeZoneFall_ = 0.999f;
   float histAcc_[kShapeHistBins] {};
   float histDisp_[kShapeHistBins] {};
+  /** Float scratch for hosts that process in 64-bit (one block, L then R). */
+  std::vector<float> blockScratch_;
+  int blockCap_ = 0;
 };
 
 } // namespace Crusher
