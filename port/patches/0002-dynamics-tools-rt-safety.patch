From 53ad873dd42060d4b22971f2f3e9aff86ab9bbcd Mon Sep 17 00:00:00 2001
From: Matt Hardy <matt@deuso.de>
Date: Fri, 18 Sep 2026 12:57:09 +0200
Subject: [PATCH] dynamics/tools: remove audio-thread viz mutexes across 8
 plugins

Same pattern as the compressor: per-sample scalars become std::atomic<float>
(expander point, mbcomp per-band points), per-block array snapshots become a
seqlock (odd/even sequence; UI reader retries, audio thread never blocks).
Every publish*Snapshot() early-outs when no viz consumer is active.

deesser, expander, limiter, mbcomp, mblimiter, octaver, transients, tuner.

GPL-3.0-or-later.
---
 dsp/deesser/source/deesser_dsp.cpp       | 33 +++++++----
 dsp/deesser/source/deesser_dsp.h         |  7 ++-
 dsp/expander/source/expander_dsp.cpp     | 61 +++++++++----------
 dsp/expander/source/expander_dsp.h       | 14 +++--
 dsp/limiter/source/limiter_dsp.cpp       | 33 +++++++----
 dsp/limiter/source/limiter_dsp.h         |  6 +-
 dsp/mbcomp/source/mbcomp_dsp.cpp         | 74 ++++++++++++------------
 dsp/mbcomp/source/mbcomp_dsp.h           | 14 +++--
 dsp/mblimiter/source/mblimiter_dsp.cpp   | 35 +++++++----
 dsp/mblimiter/source/mblimiter_dsp.h     |  6 +-
 dsp/octaver/source/octaver_dsp.cpp       | 52 ++++++++++-------
 dsp/octaver/source/octaver_dsp.h         |  6 +-
 dsp/transients/source/transients_dsp.cpp | 33 +++++++----
 dsp/transients/source/transients_dsp.h   |  7 ++-
 dsp/tuner/source/tuner_dsp.cpp           | 52 ++++++++++-------
 dsp/tuner/source/tuner_dsp.h             |  6 +-
 16 files changed, 264 insertions(+), 175 deletions(-)

diff --git a/dsp/deesser/source/deesser_dsp.cpp b/dsp/deesser/source/deesser_dsp.cpp
index 6de6333..3c7b2d2 100644
--- a/dsp/deesser/source/deesser_dsp.cpp
+++ b/dsp/deesser/source/deesser_dsp.cpp
@@ -68,13 +68,12 @@ void DeesserPlugin::resetProcessing()
   histSampleCount_ = 0;
   histSamplesPerSlot_ = 1;
   histVisibleSlots_ = 160;
-  {
-    std::lock_guard<std::mutex> lock(histMutex_);
-    std::memset(histSnapshot_, 0, sizeof(histSnapshot_));
-    histSnapshotPos_ = 0;
-    histSnapshotSampleCount_ = 0;
-    histSnapshotSamplesPerSlot_ = 1;
-  }
+  histSeq_.fetch_add(1, std::memory_order_release); // odd: write in progress
+  std::memset(histSnapshot_, 0, sizeof(histSnapshot_));
+  histSnapshotPos_ = 0;
+  histSnapshotSampleCount_ = 0;
+  histSnapshotSamplesPerSlot_ = 1;
+  histSeq_.fetch_add(1, std::memory_order_release); // even: stable
 }
 
 tresult PLUGIN_API DeesserPlugin::setActive(TBool state)
@@ -127,11 +126,14 @@ void DeesserPlugin::histFeedSample(float audioPeakLin, float detPeakLin, float g
 
 void DeesserPlugin::publishHistSnapshot()
 {
-  std::lock_guard<std::mutex> lock(histMutex_);
+  if (!vizConsumerActive())
+    return;
+  histSeq_.fetch_add(1, std::memory_order_release); // odd: write in progress
   std::memcpy(histSnapshot_, histBuf_, sizeof(histBuf_));
   histSnapshotPos_ = histPos_;
   histSnapshotSampleCount_ = histSampleCount_;
   histSnapshotSamplesPerSlot_ = histSamplesPerSlot_;
+  histSeq_.fetch_add(1, std::memory_order_release); // even: stable
 }
 
 void DeesserPlugin::processSample(const BlockState& state, float& L, float& R)
@@ -218,8 +220,12 @@ int DeesserPlugin::takeEnvelopeDisplay(float* out, int maxOut)
     return 0;
 
   float phase = 0.f;
+  // Seqlock read: retry while the audio thread is mid-publish.
+  for (int attempt = 0; attempt < 8; ++attempt)
   {
-    std::lock_guard<std::mutex> lock(histMutex_);
+    const uint32_t s0 = histSeq_.load(std::memory_order_acquire);
+    if (s0 & 1u)
+      continue; // write in progress
     const int startPos =
       (kHistBufSize + histSnapshotPos_ - (slots - 1) * kHistChannels) % kHistBufSize;
     const int sps = std::max(1, histSnapshotSamplesPerSlot_);
@@ -234,9 +240,14 @@ int DeesserPlugin::takeEnvelopeDisplay(float* out, int maxOut)
         gr = 1.f;
       out[i * kHistChannels + 2] = std::clamp(gr, 1.0e-6f, 1.f);
     }
+    const uint32_t s1 = histSeq_.load(std::memory_order_acquire);
+    if (s0 == s1)
+    {
+      out[outCount] = std::clamp(phase, 0.f, 1.f);
+      return outCount + 1;
+    }
   }
-  out[outCount] = std::clamp(phase, 0.f, 1.f);
-  return outCount + 1;
+  return 0; // contended; skip this frame
 }
 
