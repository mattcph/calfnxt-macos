   void idleSanitize(int nFrames);
+  /** Host silenceFlags, editor open: step limiters and viz by a full block of zeros. */
+  void decaySilenceViz(Steinberg::int32 nFrames, float displayLimit);
+  bool limitersSleeping() const;
 
   float params_[kParamCount] {};
   Dsp::IoStage io_;
diff --git a/dsp/tamer/source/tamer_dsp.cpp b/dsp/tamer/source/tamer_dsp.cpp
index 5aace98..2ca86ea 100644
--- a/dsp/tamer/source/tamer_dsp.cpp
+++ b/dsp/tamer/source/tamer_dsp.cpp
@@ -55,6 +55,7 @@ void TamerPlugin::resetProcessing()
 {
   tamer_.reset();
   flushLeft_ = 0;
+  vizFloor_ = false;
   applyBlockState(makeBlockState());
   updateLatency();
 }
@@ -154,7 +155,24 @@ tresult PLUGIN_API TamerPlugin::process(ProcessData& data)
 
   const bool hasHostAudio = io_.begin(data);
   if (!hasHostAudio)
+  {
+    // Host silenceFlags: buffers are unusable. Feed a private block of zeros
+    // so an open editor's spectrum and GR fall, then park. Do not write outs.
+    if (vizConsumerActive() && !vizFloor_ && data.numSamples > 0)
+    {
+      const int32 n = data.numSamples;
+      ensureScScratch(n);
+      std::fill_n(scScratchL_.data(), static_cast<size_t>(n), 0.f);
+      std::fill_n(scScratchR_.data(), static_cast<size_t>(n), 0.f);
+      tamer_.process(scScratchL_.data(), scScratchR_.data(), n, state.bypass, false,
+                     true, state.channel, nullptr, nullptr, false, false);
+      tamer_.publish();
+      if (tamer_.displayNearFloor())
+        vizFloor_ = true;
+    }
     return kResultOk;
+  }
+  vizFloor_ = false;
 
   const int32 nFrames = data.numSamples;
   if (nFrames <= 0)
diff --git a/dsp/tamer/source/tamer_dsp.h b/dsp/tamer/source/tamer_dsp.h
index e853528..ac6acce 100644
--- a/dsp/tamer/source/tamer_dsp.h
+++ b/dsp/tamer/source/tamer_dsp.h
@@ -92,6 +92,8 @@ private:
   Steinberg::uint32 latencySamples_ = 0;
   /** Samples left to drain wet/OLA after input goes quiet before parking STFT. */
   int flushLeft_ = 0;
+  /** Host silenceFlags: STFT fed zeros until the chart hit the floor. */
+  bool vizFloor_ = false;
 };
 
