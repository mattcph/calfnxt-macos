-  origLengthMs_ = preparedIr_.frames > 0 && preparedIr_.sampleRate > 0.f
-                    ? 1000.f * static_cast<float>(preparedIr_.frames) / preparedIr_.sampleRate
-                    : 0.f;
+  origLengthMs_.store(preparedIr_.frames > 0 && preparedIr_.sampleRate > 0.f
+                        ? 1000.f * static_cast<float>(preparedIr_.frames) / preparedIr_.sampleRate
+                        : 0.f,
