+      out[0] = 0.f;
+    }
+    out[1] = origMs;
     out[2] = used;
-    return 3;
+    const uint32_t s1 = waveSeq_.load(std::memory_order_acquire);
+    if (s0 == s1)
+    {
+      waveDirty_.store(false, std::memory_order_relaxed);
+      return n;
+    }
   }
-  out[0] = static_cast<float>(bins);
-  out[1] = origLengthMs_;
-  out[2] = used;
-  std::memcpy(out + 3, waveDb_.data(), sizeof(float) * static_cast<size_t>(bins));
